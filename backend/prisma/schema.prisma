generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  trainer
  member
}

enum UserStatus {
  active
  inactive
  suspended
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(member)
  status       UserStatus @default(active)

  // RD05: cada membro tem no máximo um instrutor responsável.
  instructorId Int?
  instructor   User?  @relation("UserInstructor", fields: [instructorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  members      User[] @relation("UserInstructor")

  // RNF14: só o hash do refresh token é persistido; nada fica em memória.
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
