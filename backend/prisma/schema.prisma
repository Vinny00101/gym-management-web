generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  trainer
  member
}

enum UserStatus {
  active
  inactive
  suspended
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(member)
  status       UserStatus @default(active)

  // RD05: cada membro tem no máximo um instrutor responsável.
  instructorId Int?
  instructor   User?  @relation("UserInstructor", fields: [instructorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  members      User[] @relation("UserInstructor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
}
