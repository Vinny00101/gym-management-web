# API
PORT=3000
NODE_ENV=development

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gym_management
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@localhost:5432/gym_management

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth
# Troque por um segredo aleatório de pelo menos 32 caracteres em produção.
JWT_SECRET=change-me-by-a-long-random-value
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Seed/Admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
